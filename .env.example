# LiveKit (local dev server defaults shown; swap for LiveKit Cloud project values)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=summoners-local-dev-secret-0123456789abcdef

# Every key below is optional: a missing key swaps that stage for a keyless mock
# (scripted game master and demon brains, duration-only speech recognition,
# Windows SAPI / bleep voices, SVG sticker sprites). See README "Mocks".

# Claude (demons + game master)
ANTHROPIC_API_KEY=

# Speech
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Images (fal.ai flux/schnell for summon sprites; FAL_API_KEY also accepted)
FAL_KEY=

# Game server
PORT=8787
GAME_SERVER_URL=http://localhost:8787
GAME_SERVER_SECRET=change-me

# Model tuning (optional). Opus 5.5 with thinking is the default everywhere; effort low keeps
# rounds fast. Demons default to Sonnet 5.5 (half the price, faster first token); GM_ROUND_MS (default 7000) sets the gap between rounds.
# GM_MODEL=claude-opus-5-5
# GM_EFFORT=low
# DEMON_MODEL=claude-sonnet-5-5
# DEMON_EFFORT=low

# Cost (optional). Pause a room's game master and demons once its estimated spend crosses this:
# ROOM_BUDGET_USD=20
# Third-party list prices used for the estimate (defaults in packages/shared/src/cost.ts):
# PRICE_STT_PER_MIN=0.0077
# PRICE_TTS_PER_CHAR=0.00005
# PRICE_IMAGE_EACH=0.003
