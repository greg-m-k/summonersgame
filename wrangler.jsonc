{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "summoners",
  "main": "deploy/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "a5ac50eac3fc3bba71323b08817bd04e",
  // A Custom Domain: Cloudflare creates the DNS record and certificate for games.greg.kitchen itself.
  // (A plain route would need a proxied DNS record for the subdomain to exist first.)
  "routes": [{ "pattern": "games.greg.kitchen", "custom_domain": true }],
  "assets": {
    "directory": "deploy/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "containers": [
    {
      "class_name": "GameServer",
      "image": "./deploy/server.Dockerfile",
      "image_build_context": ".",
      "max_instances": 2,
      "instance_type": "basic"
    },
    {
      "class_name": "DemonWorker",
      "image": "./deploy/agents.Dockerfile",
      "image_build_context": ".",
      "max_instances": 2,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GAME_SERVER", "class_name": "GameServer" },
      { "name": "DEMON_WORKER", "class_name": "DemonWorker" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameServer", "DemonWorker"] }],
  "d1_databases": [{ "binding": "LOGS", "database_name": "summoners-logs", "database_id": "0765e37c-b127-4230-bb9a-a02e2eb4ca49" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "PUBLIC_URL": "https://games.greg.kitchen/summoners",
    "INSTANCE_GEN": "13",
    "HEART_HP": "1200"
  },
  "observability": { "enabled": true }
}
